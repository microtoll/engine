  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/microtoll/engine.git",
    "directory": "packages/mailbox"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "types",
    "README.md",
    "CHANGELOG.md",
    "FORMATS.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "dependencies": {
    "@microtoll/crypto-core": "0.1.2",
    "@microtoll/identity": "0.1.2"
  }
}
